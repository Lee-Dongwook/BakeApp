# Used by Docker Compose. Copy to .env only when you need to override its local defaults.
POSTGRES_DB=bakeapp
POSTGRES_USER=bakeapp
POSTGRES_PASSWORD=change_this_local_database_password

# This hostname is for the API container. Do not use `localhost` here.
DATABASE_URL=postgresql://bakeapp:change_this_local_database_password@db:5432/bakeapp
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
FRONTEND_ORIGIN=http://localhost:5173
