# NestJS API port
PORT=3000

# Local PostgreSQL example. Change host, port, database, user, and password as needed.
DATABASE_URL=postgresql://bakeapp:bakeapp@localhost:5432/bakeapp

# Required: at least 32 random characters. Never commit a real value.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# Comma-separated origins are supported when more than one frontend is allowed.
FRONTEND_ORIGIN=http://localhost:5173

# Set to true only when the PostgreSQL server requires TLS (for example, many cloud DBs).
# DATABASE_SSL=true
